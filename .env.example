# APPLICATION
NODE_ENV=development
PORT=5000
APP_NAME=RunCodeAITeacher
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
BACKEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/RuncodeAiTeacher?schema=public
DB_NAME=RuncodeAiTeacher
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# BREVO EMAIL
EMAIL_PROVIDER=brevo
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=tmaq77@gmail.com
BREVO_SENDER_NAME=RunCodeAITeacher
ENABLE_DEV_EMAIL_SIMULATION=true

# GEMINI AI
GEMINI_API_KEY_PRIMARY=YOUR_PRIMARY_KEY
GEMINI_API_KEY_SECONDARY=YOUR_SECONDARY_KEY
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# OTP & AUTH
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_SENDS_PER_15_MINUTES=3
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
OTP_HMAC_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
SESSION_MAX_AGE_HOURS=24
SINGLE_ACTIVE_SESSION=true
BCRYPT_COST_FACTOR=12

# DEFAULT ADMIN CREDENTIALS
ADMIN_USERNAME=temur
ADMIN_PASSWORD=Temur20
ADMIN_EMAIL=admin@runcode.uz

# SIGNUP & CREDITS
FREE_SIGNUP_CREDITS=100
CREDIT_INTERNAL_UNITS=1000
PAID_USAGE_DISCOUNT_FACTOR=1.5
REWARD_DAILY_LIMIT=10

# PACKAGES
PLUS_BASE_CREDITS=200
PLUS_BONUS_CREDITS=20
PLUS_PRICE_UZS=15000

PRO_BASE_CREDITS=500
PRO_BONUS_CREDITS=50
PRO_PRICE_UZS=30000

MAX_BASE_CREDITS=1000
MAX_BONUS_CREDITS=100
MAX_PRICE_UZS=50000

# PAYMENTS
PAYMENT_MODE=manual
MANUAL_PAYMENT_WINDOW_MINUTES=30
PAYMENT_REVIEW_ESTIMATE_MIN_HOURS=1
PAYMENT_REVIEW_ESTIMATE_MAX_HOURS=2

# CLICK
CLICK_PAYMENT_ENABLED=true
CLICK_PAYMENT_QR_ASSET=/assets/payments/click_qr.png
CLICK_PAYMENT_URL=https://my.click.uz/clickp2p/9E9EB6EE67E40DB610877D03FC6AB8BD136BDBF5F386F48C91E40184E1EB9EE7
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# UZUM BANK
UZUM_PAYMENT_ENABLED=true
UZUM_PAYMENT_QR_ASSET=/assets/payments/uzum_qr.png
UZUM_PAYMENT_URL=https://b.2u.uz/ttc?qr=Nzk5MzoyMDU4NjEzMjowMU00VDA0VlgyNjVYQU1IR1k5SjdNV1ZEODp1OVhXZWtrenRJNmNadm5oZVhXQ1NhOWJOdFk9
UZUM_MERCHANT_ID=
UZUM_MERCHANT_SECRET=

# UPLOADS & STORAGE
PAYMENT_RECEIPT_MAX_SIZE_MB=10
RECEIPT_STORAGE_PROVIDER=local
RECEIPT_PRIVATE_DIRECTORY=./private/receipts

# JOBS & SECURITY
PAYMENT_EXPIRY_JOB_ENABLED=true
PAYMENT_RECONCILIATION_ENABLED=true
CREDIT_RESERVATION_RECOVERY_ENABLED=true
AUTH_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
LOG_REDACT_SECRETS=true
LOG_LEVEL=info
