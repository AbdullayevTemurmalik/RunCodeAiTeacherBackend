datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Tier {
  FREE
  PLUS
  PRO
  MAX
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CreditBucket {
  SIGNUP
  PURCHASED
  BONUS
  REWARD
  CONSUMPTION
  REFUND
  ADJUSTMENT
}

enum ReservationStatus {
  PENDING
  COMMITTED
  RELEASED
}

enum PaymentOrderStatus {
  CREATED
  AWAITING_PAYMENT
  RECEIPT_SUBMITTED
  UNDER_REVIEW
  PAYMENT_CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

enum FulfillmentStatus {
  NOT_FULFILLED
  FULFILLED
  REVERSED
}

enum PaymentMethod {
  UNSELECTED
  CLICK
  UZUM
}

enum PaymentReviewDecision {
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}

enum NotificationType {
  WELCOME
  CREDIT_DEDUCTION
  LOW_BALANCE
  REWARD
  PURCHASE_PENDING
  PURCHASE_SUCCESS
  PURCHASE_FAILED
  SECURITY_SESSION
  ACHIEVEMENT
  ANNOUNCEMENT
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  age          Int?
  role         Role       @default(USER)
  tier         Tier       @default(FREE)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  language     String     @default("uz")
  theme        String     @default("dark")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions           UserSession[]
  wallet             CreditWallet?
  speakingSessions   SpeakingSession[]
  writingSubmissions WritingSubmission[]
  essaySubmissions   EssaySubmission[]
  rewardGrants       RewardGrant[]
  notifications      Notification[]
  paymentOrders      PaymentOrder[]
  auditLogs          AdminAuditLog[]
  aiUsageEvents      AiUsageEvent[]

  @@index([email])
  @@index([username])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([tokenHash])
}

model EmailVerification {
  id          String   @id @default(uuid())
  email       String
  hashedOtp   String
  attempts    Int      @default(0)
  resendCount Int      @default(1)
  isUsed      Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([email, isUsed])
}

model PasswordReset {
  id             String   @id @default(uuid())
  email          String
  hashedOtp      String
  attempts       Int      @default(0)
  isVerified     Boolean  @default(false)
  isUsed         Boolean  @default(false)
  resetTokenHash String?  @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([email, isVerified, isUsed])
}

model CreditWallet {
  id                  String   @id @default(uuid())
  userId              String   @unique
  balanceUnits        BigInt   @default(100000) // 100 credits * 1000 units
  freeUnits           BigInt   @default(100000)
  paidUnits           BigInt   @default(0)
  bonusUnits          BigInt   @default(0)
  rewardUnits         BigInt   @default(0)
  lifetimeEarnedUnits BigInt   @default(100000)
  lifetimeSpentUnits  BigInt   @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger       CreditLedger[]
  reservations CreditReservation[]
}

model CreditLedger {
  id                String       @id @default(uuid())
  walletId          String
  amountUnits       BigInt
  bucket            CreditBucket
  reason            String
  referenceType     String?
  referenceId       String?
  balanceAfterUnits BigInt
  idempotencyKey    String?      @unique
  metadata          Json?
  createdAt         DateTime     @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

model CreditReservation {
  id            String            @id @default(uuid())
  walletId      String
  amountUnits   BigInt
  status        ReservationStatus @default(PENDING)
  operationType String
  operationId   String            @unique
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
}

model CreditPackage {
  id           String   @id @default(uuid())
  code         String   @unique // FREE, PLUS, PRO, MAX
  name         String
  baseCredits  Int
  bonusCredits Int
  totalCredits Int
  priceUzs     Int
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RewardGrant {
  id            String   @id @default(uuid())
  userId        String
  activityType  String
  activityId    String
  score         Float
  amountCredits Int
  grantedDate   String   // YYYY-MM-DD
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityType, activityId])
  @@index([userId, grantedDate])
}

model PaymentOrder {
  id                String             @id @default(uuid())
  orderNumber       String             @unique
  userId            String
  packageCode       String
  amountUzs         Int
  creditsToGrant    Int
  status            PaymentOrderStatus @default(CREATED)
  fulfillmentStatus FulfillmentStatus  @default(NOT_FULFILLED)
  method            PaymentMethod      @default(UNSELECTED)
  paymentExpiresAt  DateTime
  cancelReason      String?
  cancelComment     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt PaymentReceipt?
  review  PaymentReview?
  events  PaymentEvent[]
  refunds PaymentRefund[]

  @@index([userId, status])
  @@index([orderNumber])
}

model PaymentReceipt {
  id           String   @id @default(uuid())
  orderId      String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  storedPath   String
  uploadedAt   DateTime @default(now())

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentReview {
  id         String                @id @default(uuid())
  orderId    String                @unique
  adminId    String
  decision   PaymentReviewDecision
  note       String?
  reviewedAt DateTime              @default(now())

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id        String   @id @default(uuid())
  orderId   String
  eventType String
  details   Json?
  createdAt DateTime @default(now())

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model PaymentRefund {
  id         String   @id @default(uuid())
  orderId    String
  adminId    String
  amountUzs  Int
  reason     String
  refundedAt DateTime @default(now())

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentProviderSetting {
  id          String   @id @default(uuid())
  provider    String   @unique // CLICK, UZUM
  isEnabled   Boolean  @default(true)
  qrAssetUrl  String
  deepLinkUrl String
  merchantId  String?
  serviceId   String?
  secretKey   String?
  updatedAt   DateTime @default(now())
}

model SpeakingSession {
  id              String        @id @default(uuid())
  userId          String
  level           String
  topic           String
  languageMode    String        @default("EN_EN")
  status          SessionStatus @default(ACTIVE)
  durationSeconds Int           @default(0)
  inputTokens     Int           @default(0)
  outputTokens    Int           @default(0)
  creditsCharged  Int           @default(0)
  report          Json?
  startedAt       DateTime      @default(now())
  endedAt         DateTime?

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns SpeakingTurn[]

  @@index([userId, status])
}

model SpeakingTurn {
  id              String   @id @default(uuid())
  sessionId       String
  speaker         String   // user, ai
  transcript      String
  audioDurationMs Int?
  corrections     Json?
  createdAt       DateTime @default(now())

  session SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model WritingSubmission {
  id               String           @id @default(uuid())
  userId           String
  level            String
  topicType        String           // FREE, TOPIC
  topicTitle       String?
  targetWordCount  Int
  actualWordCount  Int
  text             String
  status           SubmissionStatus @default(SUBMITTED)
  overallScore     Float?
  evaluationResult Json?
  audioTtsUrl      String?
  creditsCharged   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model EssayTask {
  id              String   @id @default(uuid())
  level           String
  category        String
  targetWordCount Int
  difficulty      String
  title           String
  instructions    String
  requiredWords   Json     // array of strings
  createdAt       DateTime @default(now())

  submissions EssaySubmission[]
}

model EssaySubmission {
  id               String           @id @default(uuid())
  taskId           String
  userId           String
  text             String
  wordCount        Int
  matchedWords     Json
  missingWords     Json
  status           SubmissionStatus @default(SUBMITTED)
  overallScore     Float?
  evaluationResult Json?
  creditsCharged   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  task EssayTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AiEvaluation {
  id                 String   @id @default(uuid())
  targetType         String   // SPEAKING, WRITING, ESSAY
  targetId           String
  overallScore       Float
  grammarScore       Float?
  vocabularyScore    Float?
  fluencyScore       Float?
  pronunciationScore Float?
  clarityScore       Float?
  cohesionScore      Float?
  strengths          Json?
  weaknesses         Json?
  corrections        Json?
  rewrittenExample   String?
  createdAt          DateTime @default(now())

  @@index([targetType, targetId])
}

model AiUsageEvent {
  id              String   @id @default(uuid())
  userId          String
  model           String
  operationType   String
  promptTokens    Int      @default(0)
  candidateTokens Int      @default(0)
  totalTokens     Int      @default(0)
  estimatedCostUsd Float   @default(0)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

model AppSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @default(now())
}
